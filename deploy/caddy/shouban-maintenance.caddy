{
	admin off
	auto_https off
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request delete
				req delete
				headers delete
				resp_headers>Set-Cookie delete
			}
		}
	}
	servers {
		trusted_proxies static {$SHOUBAN_TRUSTED_PROXY_CIDRS}
		trusted_proxies_strict
	}
}

:8080 {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
				request>body delete
				request>remote_ip delete
				request>client_ip delete
				resp_headers>Set-Cookie delete
			}
		}
	}

	header -Server
	header Cache-Control "private, no-store, max-age=0"
	header X-Content-Type-Options "nosniff"

	@local_health {
		remote_ip 127.0.0.1 ::1
		path /healthz
		method GET HEAD
	}
	handle @local_health {
		respond "ok" 200
	}

	@alb {
		remote_ip {$SHOUBAN_TRUSTED_PROXY_CIDRS}
		host {$SHOUBAN_SITE_DOMAIN}
	}
	handle @alb {
		header Retry-After "300"
		respond "Service temporarily unavailable" 503
	}

	handle {
		respond "Forbidden" 403
	}
}
